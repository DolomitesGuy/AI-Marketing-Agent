    {
      "parameters": {
        "jsCode": "// Campaign Health Audit V1: independent, read-only, deterministic checks.\nconst ctx=$('Build Health Context').first().json;\nconst fixture=ctx.fixture_mode===true;\nconst fixtureData=fixture?$input.first()?.json:null;\nconst apiNames=['Get Campaign Health','Get AdGroups Health','Get Ads Health'];\nconst get=(name)=>{try{return $(name).first().json??{}}catch{return {}}};\nconst api=fixture?{}:{campaign:get(apiNames[0]),groups:get(apiNames[1]),ads:$input.first()?.json??{}};\nconst source=fixture?'synthetic_fixture':'yandex_direct_live';\nconst problems=[];const checks=[];const quality=[];\nconst add=(code,severity,title,detail={},action='review')=>{\n  problems.push({code,severity,title,evidence:detail,recommended_check:action,requires_human_review:true});\n};\nconst check=(name,status,reason)=>checks.push({name,status,reason});\nconst fmt=v=>String(v??'').toUpperCase();\nconst num=v=>{if(v===null||v===undefined||v===''||v==='--')return null;const x=Number(v);return Number.isFinite(x)&&x>=0?x:null};\nconst positive=v=>{const x=num(v);return x!==null&&x>0?x:null};\nlet campaign=null,groups=null,ads=null;\nif(fixture){campaign=fixtureData.campaign;groups=fixtureData.groups;ads=fixtureData.ads;}\nelse{\n const configs=[['campaign',api.campaign,'Campaigns'],['groups',api.groups,'AdGroups'],['ads',api.ads,'Ads']];\n for(const [label,res,key] of configs){\n  if(res.error||res.Error){quality.push(`${label}_api_error`);continue;}\n  if(!Array.isArray(res.result?.[key])){quality.push(`${label}_response_unavailable`);continue;}\n  if(res.result?.LimitedBy!==undefined&&res.result?.LimitedBy!==null){quality.push(`${label}_pagination_incomplete`);continue;}\n  if(label==='campaign')campaign=res.result[key].find(c=>String(c.Id)===ctx.external_campaign_id)??null;\n  if(label==='groups')groups=res.result[key].filter(g=>String(g.CampaignId)===ctx.external_campaign_id);\n  if(label==='ads')ads=res.result[key].filter(a=>String(a.CampaignId)===ctx.external_campaign_id);\n }\n}\nconst date=new Date().toISOString();\nconst base={contract_version:1,operation_type:'campaign_health_audit',client_id:ctx.client_id,campaign_id:ctx.campaign_id,external_campaign_id:ctx.external_campaign_id,campaign_name:ctx.campaign_name,checked_at:date,source,test_mode:ctx.test_mode,fixture_mode:ctx.fixture_mode,fixture_scenario:fixture?ctx.fixture_scenario:null,analysis_created_at:fixture?fixtureData.analysis_created_at:ctx.analysis_created_at,safety:{read_only:true,can_propose_changes:false,can_execute:false,requires_human_review:true}};\nif(!campaign){quality.push('campaign_unavailable');return[{json:{...base,status:'unavailable',health:'unknown',findings:[],checks,summary:{critical:0,warning:0,info:0,issues:0},data_quality:{status:'incomplete',warnings:quality},recommendations:['Check Direct API campaign access and response']}}];}\nconst cStatus=fmt(campaign.Status),cState=fmt(campaign.State),payment=fmt(campaign.StatusPayment);\nconst draft=['DRAFT','MODERATION','PREACCEPTED'].includes(cStatus);\nconst active=cState==='ON'&&cStatus==='ACCEPTED';\nconst config={id:String(campaign.Id),name:campaign.Name??ctx.campaign_name,status:cStatus,state:cState,payment_status:payment,status_clarification:campaign.StatusClarification??null};\nif(draft){add('CAMPAIGN_NOT_READY','info','Кампания ещё не готова к показам',{status:cStatus,state:cState},'Check review/launch readiness');check('campaign_lifecycle','attention','Draft/moderation: absence of traffic is expected');}\nelse if(cStatus==='REJECTED'){add('CAMPAIGN_REJECTED','critical','Модерация кампании отклонена',{status:cStatus,clarification:config.status_clarification},'Review rejection reasons');check('campaign_lifecycle','problem','Campaign rejected');}\nelse if(['SUSPENDED','OFF','ENDED','ARCHIVED'].includes(cState)){add('CAMPAIGN_NOT_SERVING','warning','Кампания не находится в состоянии показа',{state:cState},'Check whether suspension is intended');check('campaign_lifecycle','attention',`State ${cState}`);}\nelse if(active){check('campaign_lifecycle','ok','Accepted and ON');}\nelse{check('campaign_lifecycle','unknown','Unrecognized campaign moderation/serving state');quality.push('campaign_state_unrecognized');}\nif(payment==='DISALLOWED'&&!draft){add('PAYMENT_NOT_ALLOWED','warning','Ограничены показы по статусу оплаты',{status_payment:payment},'Check campaign/account billing');check('payment','attention','Payment disallowed');}\nelse if(!payment){check('payment','unknown','Payment status not returned');}\nelse check('payment','ok',`Payment ${payment}`);\nif(groups===null){check('ad_groups','unknown','Group inventory incomplete');quality.push('groups_not_verified');}\nelse{\n const rejected=groups.filter(g=>fmt(g.Status)==='REJECTED').slice(0,20);\n if(rejected.length)add('AD_GROUPS_REJECTED','warning','Некоторые группы объявлений отклонены',{count:rejected.length,group_ids:rejected.map(g=>String(g.Id))},'Review group moderation');\n if(groups.length===0&&!draft)add('NO_AD_GROUPS','warning','У кампании не обнаружены группы объявлений',{},'Check campaign configuration');\n check('ad_groups',rejected.length?'attention':'ok',`Retrieved ${groups.length} groups`);\n}\nif(ads===null){check('ad_moderation','unknown','Ad inventory incomplete');quality.push('ads_not_verified');}\nelse{\n const rejected=ads.filter(a=>fmt(a.Status)==='REJECTED').slice(0,20);\n if(rejected.length)add('ADS_REJECTED','warning','Есть отклонённые объявления',{count:rejected.length,ad_ids:rejected.map(a=>String(a.Id)),reasons:rejected.map(a=>a.StatusClarification).filter(Boolean).slice(0,3)},'Review ad moderation reasons');\n if(!draft&&ads.length===0)add('NO_ADS','warning','В кампании нет объявлений',{},'Create/restore ads');\n else if(active&&!ads.some(a=>fmt(a.Status)==='ACCEPTED'&&fmt(a.State)==='ON'))add('NO_ACTIVE_ADS','warning','Не обнаружено активных принятых объявлений',{},'Check ad states and moderation');\n check('ad_moderation',rejected.length?'attention':'ok',`Retrieved ${ads.length} ads`);\n}\n// Use only latest matching real analysis; fixture metrics are self-contained.\nconst snap=ctx.latest_snapshot??{};\nconst rawMetrics=fixture?fixtureData.metrics:snap.metrics??null;\nconst m=rawMetrics&&typeof rawMetrics==='object'?rawMetrics:{};\nconst clicks=num(m.clicks),impressions=num(m.impressions),conversions=num(m.conversions),cost=num(m.cost);\nconst cpa=conversions!==null\n ? (conversions>0&&cost!==null?cost/conversions:null)\n : positive(m.cpa);\nconst overrideTarget=positive(ctx.target_cpa_override);\nconst campaignTarget=positive(ctx.campaign_target_cpa);\nconst businessTarget=positive(snap.business_context?.target_cpa);\nconst strategyTarget=positive(snap.strategy_context?.target_cpa);\nconst fixtureTarget=fixture?positive(fixtureData.target_cpa):null;\nconst target=overrideTarget ??\n (fixture?fixtureTarget:(campaignTarget ?? businessTarget ?? strategyTarget)) ??\n null;\nconst targetSource=overrideTarget!==null\n ? 'caller_override'\n : fixture\n   ? (fixtureTarget!==null?'synthetic_fixture':'unavailable')\n   : campaignTarget!==null\n     ? 'campaign_business_context'\n     : businessTarget!==null\n       ? 'analysis_business_context'\n       : strategyTarget!==null\n         ? 'strategy_context'\n         : 'unavailable';\nconst stamp=base.analysis_created_at;\nconst ageHours=stamp?(Date.now()-new Date(stamp).getTime())/3600000:null;\nconst fresh=ageHours!==null&&Number.isFinite(ageHours)&&ageHours>=0&&ageHours<=36;\nif(!fixture&&!draft){if(!stamp)quality.push('no_historical_analysis');else if(!fresh)quality.push('analysis_stale_over_36h');}\nif(draft){check('performance','not_applicable','Draft/moderation: no-spend evaluation is not applicable');}\nelse if(!fresh&&!fixture){check('performance','unknown','Latest matching real analysis missing or stale');}\nelse if(clicks===null||impressions===null||cost===null||conversions===null){check('performance','unknown','Required performance metrics unavailable');quality.push('performance_metrics_incomplete');}\nelse{\n if(active&&impressions===0)add('NO_IMPRESSIONS','warning','За период анализа не зарегистрированы показы',{impressions,period:snap.report_period??null},'Check serving and reporting availability');\n if(active&&clicks>=15&&conversions===0&&target!==null&&cost>=target)add('SPEND_WITHOUT_CONVERSIONS','warning','Расходы при нулевых конверсиях',{clicks,cost,conversions,target_cpa:target},'Check conversion tracking and traffic quality');\n if(active&&conversions>=3&&target!==null&&cpa!==null&&cpa>target)add('CPA_ABOVE_TARGET','warning','CPA выше настроенной цели',{cpa:Math.round(cpa*100)/100,target_cpa:target,conversions},'Review cost drivers and campaign segmentation');\n check('performance','ok','Observed metrics evaluated; no causality inferred');\n}\nconst order={critical:0,warning:1,info:2};problems.sort((a,b)=>(order[a.severity]??5)-(order[b.severity]??5));\nconst counts={critical:problems.filter(x=>x.severity==='critical').length,warning:problems.filter(x=>x.severity==='warning').length,info:problems.filter(x=>x.severity==='info').length};\nconst health=counts.critical?'critical':counts.warning?'warning':draft?'not_ready':quality.length?'unknown':'healthy';\nreturn[{json:{...base,status:'completed',health,campaign:config,inventory:{groups_count:groups?.length??null,ads_count:ads?.length??null},performance:{clicks,impressions,cost,conversions,cpa:cpa===null?null:Math.round(cpa*100)/100,target_cpa:target,target_source:targetSource,age_hours:ageHours===null?null:Math.round(ageHours*10)/10},summary:{...counts,issues:problems.length},findings:problems.slice(0,12),checks,data_quality:{status:quality.length?'partial':'complete',warnings:[...new Set(quality)]},recommendations:problems.slice(0,5).map(p=>p.recommended_check)}}];"
      },
