      "parameters": {
        "jsCode": "// One shared input contract for OPS audits. Fail closed.\nconst items = $input.all();\nif (items.length !== 1) {\n  throw new Error('OPS audit expects exactly one campaign per call. Iterate campaigns in the caller.');\n}\nconst x=items[0]?.json??{};\nconst s=v=>String(v??'').trim();\nconst uuid=v=>/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(v);\nconst mode=s(x.mode).toLowerCase();\nif(!['health','rsya'].includes(mode)) throw new Error('mode must be health or rsya');\nconst client_id=s(x.client_id), campaign_id=s(x.campaign_id);\nif(!uuid(client_id)||!uuid(campaign_id)) throw new Error('Valid client_id and campaign_id UUIDs required');\nif(typeof x.test_mode!=='boolean') throw new Error('test_mode must be an explicit boolean');\nconst fixture_mode=x.fixture_mode===true;\nif(fixture_mode&&!x.test_mode) throw new Error('Fixture requires test_mode=true');\nif(!fixture_mode&&x.test_mode) throw new Error('Non-fixture OPS audit requires test_mode=false');\nconst scenario=s(x.fixture_scenario)||'mixed';\nif (fixture_mode) {\n  const allowed=mode==='health'?['mixed','draft','healthy','no_data']:['mixed','low_data','no_data'];\n  if(!allowed.includes(scenario)) throw new Error(`Unsupported fixture_scenario for ${mode}: ${scenario}`);\n}\nconst target=x.target_cpa === '' || x.target_cpa == null ? null : Number(x.target_cpa);\nif(target!==null&&(!Number.isFinite(target)||target<=0)) throw new Error('target_cpa must be a positive number');\nreturn [{json:{\n mode, client_id,campaign_id,test_mode:x.test_mode,fixture_mode,\n fixture_scenario:scenario,target_cpa_override:target,\n operation_type:mode==='health'?'campaign_health_audit':'rsya_placement_audit',\n requested_at:new Date().toISOString()\n}}];"
