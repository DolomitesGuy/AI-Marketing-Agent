ernal =\n  str(row.external_campaign_id);\n\nif (!/^\\d+$/.test(external)) {\n  throw new Error(\n    \"Campaign external Yandex ID unavailable\"\n  );\n}\n\n// ==================================================\n// METRICA GOAL\n// ==================================================\n\n// A real goal ID is optional for the RSYA inventory\n// and placement statistics request.\n//\n// Never substitute strategy_goal_id here.\n\nconst rawGoal =\n  str(row.goal_id);\n\nconst goalId =\n  /^\\d+$/.test(rawGoal)\n    ? rawGoal\n    : null;\n\n// ==================================================\n// OUTPUT\n// ==================================================\n\nreturn [\n  {\n    json: {\n      ...request,\n\n      mode: \"rsya\",\n\n      external_campaign_id: external,\n\n      goal_id: goalId,\n\n      goal_id_available:\n        goalId !== null,\n\n      goal_metric_scope:\n        goalId !== null\n          ? \"specific_goal\"\n          : \"all_goals_aggregate\",\n\n      campaign_name:\n        row.campaign_name ?? null,\n\n      target_cpa: target,\n\n      target_source: targetSource,\n\n      analysis_created_at:\n        row.analysis_created_at ?? null,\n\n      report_period: \"LAST_30_DAYS\"\n    }\n  }\n];\n"
