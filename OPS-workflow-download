        "jsCode": "const ctx=$('Build Health Context').first().json;\nconst campaignId=Number(ctx.external_campaign_id);\nconst base={Id:campaignId,Name:ctx.campaign_name??'QA campaign',Type:'UNIFIED_CAMPAIGN',Status:'ACCEPTED',State:'ON',StatusPayment:'ALLOWED',StatusClarification:null};\nconst groups=[{Id:1001,CampaignId:campaignId,Name:'Группа 1',Status:'ACCEPTED',ServingStatus:'ELIGIBLE'}];\nconst ads=[{Id:2001,CampaignId:campaignId,AdGroupId:1001,Status:'ACCEPTED',State:'ON',StatusClarification:null}];\nconst now=new Date().toISOString();\nconst fixtures={\n mixed:{campaign:base,groups:[...groups,{Id:1002,CampaignId:campaignId,Name:'Группа 2',Status:'REJECTED',ServingStatus:'ELIGIBLE'}],ads:[...ads,{Id:2002,CampaignId:campaignId,AdGroupId:1002,Status:'REJECTED',State:'OFF',StatusClarification:'Rejected in fixture'}],metrics:{impressions:5000,clicks:140,cost:5000,conversions:4,cpa:1250},target_cpa:300},\n draft:{campaign:{...base,Status:'DRAFT',State:'OFF'},groups:[],ads:[],metrics:null,target_cpa:300},\n healthy:{campaign:base,groups,ads,metrics:{impressions:5000,clicks:150,cost:3000,conversions:12,cpa:250},target_cpa:300},\n no_data:{campaign:base,groups,ads,metrics:null,target_cpa:300}\n};\nreturn[{json:{source:'synthetic_fixture',...fixtures[ctx.fixture_scenario],analysis_created_at:now}}];"
