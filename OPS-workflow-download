      "parameters": {
        "jsCode": "// RSYA Placement Audit V2: read-only, deterministic, handles no goal and API errors.\nconst ctx = $('Build Audit Context').first().json;\nconst input = $input.first()?.json ?? {};\nconst fixture = ctx.fixture_mode === true;\nconst goal = /^\\d+$/.test(String(ctx.goal_id ?? '')) ? String(ctx.goal_id) : null;\nconst statusCode = Number(input.statusCode ?? input.response?.statusCode ?? input.error?.statusCode ?? 200);\nconst warnings = [];\nconst metricNumber = v => {\n  if (v === null || v === undefined || v === '' || v === '--' || v === '-') return null;\n  const n = Number(String(v).replace(',', '.'));\n  return Number.isFinite(n) && n >= 0 ? n : null;\n};\nconst round = n => Math.round(n * 100) / 100;\nconst targetCpa = metricNumber(ctx.target_cpa);\nconst base = {\n  contract_version: 2, operation_type: 'rsya_placement_audit',\n  client_id: ctx.client_id, campaign_id: ctx.campaign_id,\n  external_campaign_id: ctx.external_campaign_id,\n  campaign_name: ctx.campaign_name ?? null, goal_id: goal,\n  test_mode: ctx.test_mode, source: fixture ? 'synthetic_fixture' : 'yandex_direct_live',\n  report_period: ctx.report_period, target_cpa: targetCpa,\n  target_source: ctx.target_source ?? 'unavailable',\n  analysis_created_at: ctx.analysis_created_at ?? null,\n  checked_at: new Date().toISOString(),\n  goal_specific_conversions: goal !== null,\n  thresholds: { min_clicks: 15, min_spend_to_target_cpa: 1,\n                high_cpa_to_target_ratio: 2, max_returned: 15 },\n  all_placements_count: 0, candidates_found: 0, candidates: [], placements: [],\n  safety: { ready_for_proposal: false, can_execute: false,\n            human_approval_required: true },\n  data_quality: { status: 'unknown', warnings }\n};\nconst finish = (status, reason, additional = {}) => [{ json: {\n  ...base, status, reason, ...additional,\n  data_quality: { status, warnings }\n} }];\nfunction apiError(res) {\n  let e = res.error ?? res.Error ?? null;\n  const embedded = typeof e === 'string' ? e : (typeof e?.message === 'string' ? e.message : '');\n  if (embedded) {\n    const match = embedded.match(/\\{[\\s\\S]*\\}/);\n    if (match) { try { e = JSON.parse(match[0]); } catch {} }\n  }\n  let body = res.body ?? res.data;\n  if (typeof body === 'string' && body.trim().startsWith('{')) {\n    try { const parsed = JSON.parse(body); e = parsed.error ?? parsed.Error ?? e; } catch {}\n  } else if (body && typeof body === 'object') {\n    e = body.error ?? body.Error ?? e;\n  }\n  if (e && e.error) e = e.error;\n  if (e === null || e === undefined) return null;\n  if (typeof e === 'string') return { message: e.slice(0, 700) };\n  return {\n    code: e.error_code ?? e.code ?? null,\n    message: String(e.error_string ?? e.message ?? 'Reports API error').slice(0, 350),\n    detail: String(e.error_detail ?? e.description ?? '').slice(0, 700)\n  };\n}\nconst error = apiError(input);\nif (!fixture && (statusCode === 201 || statusCode === 202)) {\n  return finish('report_pending', 'Report is still in Yandex queue after retry limit');\n}\nif (error || (!fixture && (statusCode < 200 || statusCode >= 300))) {\n  return finish('report_error', error?.detail || error?.message || `HTTP ${statusCode}`, {\n    http_status: statusCode, api_error: error\n  });\n}\nconst payload = input.body ?? input.data ?? input.report_tsv ?? input;\nconst text = typeof payload === 'string' ? payload :\n  (typeof payload?.data === 'string' ? payload.data : '');\nif (!text.trim()) {\n  return finish('report_unavailable', 'HTTP response has no TSV content');\n}\nconst lines = text.replace(/^\\uFEFF/, '').trim().split(/\\r?\\n/).filter(Boolean);\nconst headers = lines[0].split('\\t').map(x => x.trim());\nconst h = key => headers.findIndex(x => x.toLowerCase() === key.toLowerCase());\nconst idCol = h('CampaignId'), networkCol = h('AdNetworkType');\nconst placeCol = h('Placement'), impressionsCol = h('Impressions');\nconst clicksCol = h('Clicks'), costCol = h('Cost');\nconst mandatory = [idCol, networkCol, placeCol, impressionsCol, clicksCol, costCol];\nif (mandatory.some(x => x < 0)) return finish('report_format_error', `Missing required TSV columns: ${headers.join(', ')}`);\nlet conversionCol = -1;\nif (goal !== null) {\n  for (const name of [`Conversions_${goal}_AUTO`, `Conversions_${goal}`, 'Conversions']) {\n    conversionCol = h(name);\n    if (conversionCol >= 0) break;\n  }\n  if (conversionCol < 0) warnings.push('Goal-specific conversions column missing: CPA signals disabled');\n} else {\n  warnings.push('Metrica goal not configured: CPA and conversion-based exclusions disabled');\n}\nconst stats = new Map();\nlet malformed = 0, wrongCampaign = 0, otherNetwork = 0;\nfor (const line of lines.slice(1)) {\n  const col = line.split('\\t');\n  if (col.length < headers.length) { malformed++; continue; }\n  if (String(col[idCol]).trim() !== String(ctx.external_campaign_id)) { wrongCampaign++; continue; }\n  if (String(col[networkCol]).trim() !== 'AD_NETWORK') { otherNetwork++; continue; }\n  const placement = String(col[placeCol] ?? '').trim();\n  const impressions = metricNumber(col[impressionsCol]);\n  const clicks = metricNumber(col[clicksCol]);\n  const cost = metricNumber(col[costCol]);\n  const conversions = conversionCol < 0 ? null : metricNumber(col[conversionCol]);\n  if (!placement || placement === '--' || [impressions, clicks, cost].some(v => v === null)) {\n    malformed++; continue;\n  }\n  const key = placement.toLowerCase();\n  if (!stats.has(key)) stats.set(key, {\n    placement, impressions: 0, clicks: 0, cost: 0,\n    conversions: conversionCol < 0 ? null : 0\n  });\n  const row = stats.get(key);\n  row.impressions += impressions;\n  row.clicks += clicks;\n  row.cost += cost;\n  if (conversionCol >= 0) {\n    if (conversions === null) row.conversions = null;\n    else if (row.conversions !== null) row.conversions += conversions;\n  }\n}\nif (malformed) warnings.push(`Malformed TSV rows skipped: ${malformed}`);\nif (wrongCampaign) warnings.push(`Foreign campaign rows ignored: ${wrongCampaign}`);\nif (otherNetwork) warnings.push(`Non-network rows ignored: ${otherNetwork}`);\nconst truncated = lines.length - 1 >= 10000;\nif (truncated) warnings.push('Reached Page.Limit=10000: report may be truncated');\nconst all = [...stats.values()];\nif (!all.length) return finish(malformed ? 'partial_data' : 'no_data', 'No usable network placement rows', {\n  all_placements_count: 0, candidates: [], candidates_found: 0\n});\nconst placements = all.sort((a, b) => b.cost - a.cost).slice(0, 15).map(a => ({\n  placement: a.placement, impressions: a.impressions, clicks: a.clicks,\n  cost: round(a.cost), conversions: a.conversions,\n  cpa: a.conversions > 0 ? round(a.cost / a.conversions) : null\n}));\nconst candidates = [];\nconst cpaUsable = goal !== null && conversionCol >= 0 && targetCpa !== null && targetCpa > 0;\nif (cpaUsable) {\n  for (const a of all) {\n    if (a.clicks < base.thresholds.min_clicks || a.conversions === null) continue;\n    const cpa = a.conversions > 0 ? a.cost / a.conversions : null;\n    let signal = null;\n    if (a.conversions === 0 && a.cost >= targetCpa) signal = 'spend_without_conversions';\n    else if (cpa !== null && cpa >= targetCpa * 2) signal = 'cpa_above_target';\n    if (signal) candidates.push({\n      placement: a.placement, signal,\n      metrics: { impressions: a.impressions, clicks: a.clicks,\n        cost: round(a.cost), conversions: a.conversions,\n        cpa: cpa === null ? null : round(cpa) },\n      recommendation_status: 'review_required', proposed_exclusion: null, auto_apply: false\n    });\n  }\n  candidates.sort((a,b) => b.metrics.cost - a.metrics.cost);\n}\nconst partial = malformed > 0 || truncated || wrongCampaign > 0 || otherNetwork > 0;\nreturn [{ json: {\n  ...base, status: partial ? 'partial_data' : 'ready_for_review', reason: null,\n  all_placements_count: all.length, candidates_found: candidates.length,\n  candidates: candidates.slice(0, base.thresholds.max_returned), placements,\n  data_quality: { status: partial ? 'partial_data' : 'complete', warnings },\n  safety: { ...base.safety, notes: [\n    'Placement statistics are not authorization for exclusions.',\n    'Use goal-specific conversion data and human review before optimizing.'\n  ] }\n} }];"
